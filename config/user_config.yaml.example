# Personal finance config. Copy to user_config.yaml and edit.
name: "Jane Doe"               # str — your name, non-empty
currency: "CAD"               # str — ISO-4217, e.g. "CAD", "USD", "EUR"
locale: "en-CA"               # str — BCP-47, e.g. "en-CA", "en-US", "fr-CA"
country: "CA"                 # str — ISO-3166-1 alpha-2, e.g. "CA", "US"
tax_jurisdiction: "CA-QC"     # str — regex ^[A-Z]{2}(-[A-Z0-9]{1,3})?$, e.g. "CA-QC", "US-CA", "CA"
fiscal_year_start_month: 1    # int — 1..12; 1 = calendar year
monthly_income_after_tax: 4200.00  # float — >= 0, in your currency above

fixed_obligations:
  # list of {name: str, amount: float > 0, cadence: str in {monthly, weekly, biweekly, annual}}
  - { name: "Rent",      amount: 1500.00, cadence: "monthly" }
  - { name: "Phone",     amount:   55.00, cadence: "monthly" }
  - { name: "Gym",       amount:   25.00, cadence: "monthly" }

financial_goals:
  # list of {name: str, target_amount: float > 0, target_date: "YYYY-MM-DD"}
  - { name: "Emergency fund", target_amount: 10000.00, target_date: "2026-12-31" }
  - { name: "Travel",         target_amount:  3000.00, target_date: "2026-09-01" }

sources:
  # list of {name: str, kind: str, parser: str, path: str}
  # name: short identifier shown in build logs
  # kind: account-type taxonomy: checking | credit_card | splitwise | paypal
  # parser: module name under finance.parsers (e.g. rbc, rbc_credit, amex, splitwise, paypal)
  # path: relative to repo root
  - { name: "rbc",        kind: "checking",    parser: "rbc",        path: "data/rbc/" }
  - { name: "rbc_credit", kind: "credit_card", parser: "rbc_credit", path: "data/rbc/" }
  - { name: "amex",       kind: "credit_card", parser: "amex",       path: "data/amex/" }
  - { name: "splitwise",  kind: "splitwise",   parser: "splitwise",  path: "data/splitwise/" }
  - { name: "paypal",     kind: "paypal",      parser: "paypal",     path: "data/" }
